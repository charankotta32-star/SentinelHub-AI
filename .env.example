# Copy to .env and fill in real values. Never commit .env.

# Bright Data Scraper Studio API key (required for services/brightdataEngine.js)
BRIGHTDATA_API_KEY=<your-brightdata-api-key>
# Bright Data collector ID (optional; code falls back to the default collector)
COLLECTOR_ID=<your-collector-id>

# Google Gemini API key (optional; services/slmEngine.js uses a local fallback when unset)
GEMINI_API_KEY=<your-gemini-api-key>

# MongoDB connection string (optional; default mongodb://127.0.0.1:27017/sentinelhub_ai)
MONGODB_URI=<your-mongodb-uri>

# Express server port (optional; default 5000)
PORT=5000
